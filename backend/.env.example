# Server Configuration
BASE_URL=http://localhost:8000
PORT=8000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs (get these after running stripe setup)
STRIPE_PRICE_WEEKLY=price_weekly_id_here
STRIPE_PRICE_MONTHLY=price_monthly_id_here
STRIPE_PRICE_YEARLY=price_yearly_id_here
STRIPE_PRICE_ONE_TIME=price_one_time_id_here

# Model Configuration
MODELS_DIR=./models
DEVICE=cuda  # or cpu

# Storage Configuration
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_AGE_HOURS=24

# Free Tier Limits
FREE_REPAIRS_LIMIT=3
FREE_MAX_RESOLUTION_WIDTH=1280
FREE_MAX_RESOLUTION_HEIGHT=720
